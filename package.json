{
  "name": "scar-fitness",
  "version": "1.0.0",
  "description": "Sistema de gest\u00e3o de academia com React, TypeScript e SQLite",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "demo": "node server/index.mjs --demo",
    "setup": "node server/setup.mjs",
    "test": "node --test tests/*.test.mjs",
    "backup": "node server/backup.mjs",
    "format": "prettier --write src server tests *.json *.ts *.html *.md .github/workflows/*.yml"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  }
}
